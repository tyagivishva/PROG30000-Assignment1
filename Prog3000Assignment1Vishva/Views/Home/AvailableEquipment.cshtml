@model IEnumerable<Equipment>
@{
    ViewData["Title"] = "Available Equipment";
}

<style>
    body {
        background: #f3f1eb;
    }
</style>

<h1>Available Equipment</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Type</th>
            <th>Description</th>
            <th>Availability</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Availability ? "table-success" : "table-danger")">
                <td>@item.Id</td>
                <td>@item.Type</td>
                <td>@item.Description</td>
                <td>@item.Availability.ToString().ToLower()</td>
            </tr>
        }
    </tbody>
</table>
